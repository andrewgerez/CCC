{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccc",
  "version": "0.1.0",
  "identifier": "dev.ccc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ccc",
        "width": 1440,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#050407",
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Isolated multi-account command center for Claude Code",
    "category": "DeveloperTool"
  }
}